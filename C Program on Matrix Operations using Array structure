#include <stdio.h>
 
#define MAX 10
 
void readMatrix(int a[MAX][MAX], int r, int c);
void displayMatrix(int a[MAX][MAX], int r, int c);
void addMatrices(int a[MAX][MAX], int b[MAX][MAX],
                 int r, int c);
void multiplyMatrices(int a[MAX][MAX], int b[MAX][MAX],
                      int r1, int c1, int c2);
void transposeMatrix(int a[MAX][MAX], int r, int c);
 
int main(void)
{
    int choice, r1, c1, r2, c2;
    int A[MAX][MAX], B[MAX][MAX];
 
    do
    {
        printf("\n===== MATRIX OPERATIONS =====\n");
        printf("1. Matrix Addition\n");
        printf("2. Matrix Multiplication\n");
        printf("3. Matrix Transpose\n");
        printf("0. Exit\n");
        printf("Enter your choice: ");
 
        if (scanf("%d", &choice) != 1)
        {
            printf("Invalid input.\n");
            return 1;
        }
 
        switch (choice)
        {
            case 1:
                printf("Enter rows and columns of matrices: ");
                scanf("%d%d", &r1, &c1);
 
                if (r1 < 1 || r1 > MAX || c1 < 1 || c1 > MAX)
                {
                    printf("Invalid dimensions. Use 1 to %d.\n", MAX);
                    break;
                }
 
                printf("Enter elements of first matrix:\n");
                readMatrix(A, r1, c1);
                printf("Enter elements of second matrix:\n");
                readMatrix(B, r1, c1);
                addMatrices(A, B, r1, c1);
                break;
 
            case 2:
                printf("Enter rows and columns of first matrix: ");
                scanf("%d%d", &r1, &c1);
                printf("Enter rows and columns of second matrix: ");
                scanf("%d%d", &r2, &c2);
 
                if (r1 < 1 || r1 > MAX || c1 < 1 || c1 > MAX ||
                    r2 < 1 || r2 > MAX || c2 < 1 || c2 > MAX)
                {
                    printf("Invalid dimensions. Use 1 to %d.\n", MAX);
                    break;
                }
 
                if (c1 != r2)
                {
                    printf("Multiplication not possible: ");
                    printf("columns of A must equal rows of B.\n");
                    break;
                }
 
                printf("Enter elements of first matrix:\n");
                readMatrix(A, r1, c1);
                printf("Enter elements of second matrix:\n");
                readMatrix(B, r2, c2);
                multiplyMatrices(A, B, r1, c1, c2);
                break;
 
            case 3:
                printf("Enter rows and columns of matrix: ");
                scanf("%d%d", &r1, &c1);
 
                if (r1 < 1 || r1 > MAX || c1 < 1 || c1 > MAX)
                {
                    printf("Invalid dimensions. Use 1 to %d.\n", MAX);
                    break;
                }
 
                printf("Enter matrix elements:\n");
                readMatrix(A, r1, c1);
                transposeMatrix(A, r1, c1);
                break;
 
            case 0:
                printf("Program closed. Thank you!\n");
                break;
 
            default:
                printf("Invalid choice. Select 0 to 3.\n");
        }
 
    } while (choice != 0);
 
    return 0;
}
 
void readMatrix(int a[MAX][MAX], int r, int c)
{
    int i, j;
    for (i = 0; i < r; i++)
        for (j = 0; j < c; j++)
            scanf("%d", &a[i][j]);
}
 
void displayMatrix(int a[MAX][MAX], int r, int c)
{
    int i, j;
    for (i = 0; i < r; i++)
    {
        for (j = 0; j < c; j++)
            printf("%d\t", a[i][j]);
        printf("\n");
    }
}
 
void addMatrices(int a[MAX][MAX], int b[MAX][MAX],
                 int r, int c)
{
    int sum[MAX][MAX], i, j;
    for (i = 0; i < r; i++)
        for (j = 0; j < c; j++)
            sum[i][j] = a[i][j] + b[i][j];
 
    printf("Sum of matrices:\n");
    displayMatrix(sum, r, c);
}
 
void multiplyMatrices(int a[MAX][MAX], int b[MAX][MAX],
                      int r1, int c1, int c2)
{
    int product[MAX][MAX] = {0};
    int i, j, k;
 
    for (i = 0; i < r1; i++)
        for (j = 0; j < c2; j++)
            for (k = 0; k < c1; k++)
                product[i][j] += a[i][k] * b[k][j];
 
    printf("Product of matrices:\n");
    displayMatrix(product, r1, c2);
}
 
void transposeMatrix(int a[MAX][MAX], int r, int c)
{
    int trans[MAX][MAX], i, j;
 
    for (i = 0; i < r; i++)
        for (j = 0; j < c; j++)
            trans[j][i] = a[i][j];
 
    printf("Transpose of matrix:\n");
    displayMatrix(trans, c, r);
}

 
